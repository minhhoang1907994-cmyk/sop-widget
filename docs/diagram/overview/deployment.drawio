<mxfile host="app.diagrams.net" type="device">
  <diagram id="sop-widget-deployment" name="Deployment v2.0">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SOP Widget — deployment, v2.0" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Data for running an SOP stays on the operator machine. The server holds accounts and shared report files only (BR-20)." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="machine" value="Operator machine — Windows" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="480" height="620" as="geometry" />
        </mxCell>
        <mxCell id="app" value="SOP Widget (Tauri 2)&#10;WebView + Rust core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="machine">
          <mxGeometry x="30" y="50" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="React 18 + Vite&#10;App.tsx, api.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="machine">
          <mxGeometry x="260" y="50" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="SQLite — sop-widget.db&#10;procedures, steps, runs,&#10;step_executions, auth_session" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="machine">
          <mxGeometry x="30" y="180" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="evidence\{run_id}\*.png&#10;original screenshots&#10;never uploaded" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="machine">
          <mxGeometry x="260" y="180" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="reports_local" value="reports\*.html&#10;exported locally first,&#10;then uploaded (BR-22)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="machine">
          <mxGeometry x="30" y="320" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="serverenv" value="server.env&#10;SOP_SERVER_URL=...&#10;created on first launch,&#10;admin edits it — no rebuild" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e6d0de;strokeColor=#996185;fontSize=11;align=left;" vertex="1" parent="machine">
          <mxGeometry x="260" y="320" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="appdata" value="All of the above lives under&#10;%APPDATA%\NTA\SOP Widget" style="text;html=1;fontSize=11;fontColor=#666666;align=center;" vertex="1" parent="machine">
          <mxGeometry x="30" y="418" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="Default browser&#10;opens the share link — its own web session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=11;" vertex="1" parent="machine">
          <mxGeometry x="30" y="470" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note_offline" value="With a valid session, everything here works without the network:&#10;running an SOP, capturing evidence, exporting to disk, local history." style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="machine">
          <mxGeometry x="30" y="545" width="430" height="40" as="geometry" />
        </mxCell>

        <mxCell id="server" value="Server — 54.178.76.191 (Docker Compose)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="500" height="620" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="Reverse proxy + TLS&#10;NOT SET UP YET — see the warning below" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="server">
          <mxGeometry x="30" y="45" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="api" value="api — Node 24 + Fastify 5&#10;/api/v1/* for the app · /login, /r/:id for browsers&#10;migrations run at startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="server">
          <mxGeometry x="30" y="125" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="db — MySQL 8&#10;users, sessions, reports,&#10;report_recipients, schema_migrations" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="server">
          <mxGeometry x="30" y="240" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="volume" value="volume report-data&#10;/data/reports/{yyyy}/{MM}/{id}.html&#10;DB stores the relative path only" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" vertex="1" parent="server">
          <mxGeometry x="290" y="240" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dbport" value="MySQL port bound to 127.0.0.1 only.&#10;Publishing it on 0.0.0.0 would expose the&#10;database to the internet." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="server">
          <mxGeometry x="30" y="370" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="Backup needs BOTH:&#10;mysqldump AND the report-data volume.&#10;DB alone leaves rows pointing at nothing." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;" vertex="1" parent="server">
          <mxGeometry x="30" y="450" width="440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="notstored" value="What the server never receives:&#10;procedures, steps, runs, step_executions,&#10;or the original PNG files. Evidence only&#10;travels embedded as base64 inside a report." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;" vertex="1" parent="server">
          <mxGeometry x="30" y="530" width="440" height="75" as="geometry" />
        </mxCell>

        <mxCell id="warn" value="⚠ Blocking condition before real users: the server currently serves plain http:// on a public IP.&#10;Passwords, 30-day session tokens and report files — which may contain credentials visible in a screenshot —&#10;would travel unencrypted. Set up HTTPS or put the server behind a VPN first. See docs/deployment.md." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_login" value="POST /api/v1/auth/login&#10;Bearer token, 30 days" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.25;entryX=0;entryY=0.3;" edge="1" source="machine" target="server" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_upload" value="POST /api/v1/reports&#10;multipart upload of the HTML" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.45;entryX=0;entryY=0.5;" edge="1" source="machine" target="server" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_inbox" value="GET /api/v1/reports/inbox" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.6;entryX=0;entryY=0.62;" edge="1" source="machine" target="server" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_web" value="GET /r/{id} — cookie session,&#10;a separate sign-in from the app" style="html=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.78;" edge="1" source="machine" target="server" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_apidb" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" source="api" target="mysql" parent="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_apivol" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" source="api" target="volume" parent="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_proxyapi" style="html=1;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="proxy" target="api" parent="server"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_appui" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="app" target="ui" parent="machine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_appdb" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="app" target="sqlite" parent="machine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_appev" style="html=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="ui" target="evidence" parent="machine"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
