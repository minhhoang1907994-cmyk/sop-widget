<mxfile host="app.diagrams.net" type="device">
  <diagram id="sop-widget-login" name="Sign in and forced password change">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="user" value="Operator" style="shape=umlLifeline;perimeter=mxPerimeter.rectanglePerimeter;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="130" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="React UI&#10;App.tsx (Login)" style="shape=umlLifeline;perimeter=mxPerimeter.rectanglePerimeter;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="230" y="40" width="150" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="cmd" value="Tauri command&#10;login / current_session" style="shape=umlLifeline;perimeter=mxPerimeter.rectanglePerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="180" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="local" value="SQLite&#10;auth_session" style="shape=umlLifeline;perimeter=mxPerimeter.rectanglePerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="140" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="conf" value="Config&#10;env / server.env" style="shape=umlLifeline;perimeter=mxPerimeter.rectanglePerimeter;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="880" y="40" width="150" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="api" value="Server&#10;POST /api/v1/auth/*" style="shape=umlLifeline;perimeter=mxPerimeter.rectanglePerimeter;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;" vertex="1" parent="1">
          <mxGeometry x="1090" y="40" width="180" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="MySQL&#10;users, sessions" style="shape=umlLifeline;perimeter=mxPerimeter.rectanglePerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1330" y="40" width="150" height="1140" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="Open the app" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.04;entryX=0;entryY=0.04;" edge="1" source="user" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m2" value="invoke(&apos;current_session&apos;)" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.07;entryX=0;entryY=0.07;" edge="1" source="ui" target="cmd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m3" value="SELECT * FROM auth_session WHERE id = 1" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.10;entryX=0;entryY=0.10;" edge="1" source="cmd" target="local" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m4" value="none, or expires_at already past → row deleted" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;dashed=1;exitX=0;exitY=0.13;entryX=1;entryY=0.13;" edge="1" source="local" target="cmd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m5" value="null → render the login view" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;dashed=1;exitX=0;exitY=0.16;entryX=1;entryY=0.16;" edge="1" source="cmd" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="m6" value="invoke(&apos;server_url&apos;) — for display only" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.20;entryX=0;entryY=0.20;" edge="1" source="ui" target="cmd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m7" value="SOP_SERVER_URL, else server.env, else localhost:8080" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.23;entryX=0;entryY=0.23;" edge="1" source="cmd" target="conf" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="m8" value="Type username + password" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.28;entryX=0;entryY=0.28;" edge="1" source="user" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m9" value="api.login(username, password) — no server address passed" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.31;entryX=0;entryY=0.31;" edge="1" source="ui" target="cmd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m10" value="POST /api/v1/auth/login" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" source="cmd" target="api" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m11" value="rate limit check — 10 tries / 15 min, per IP and per username" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.38;entryX=1;entryY=0.38;strokeColor=#996185;fontColor=#996185;" edge="1" source="api" target="api" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m12" value="SELECT * FROM users WHERE username = ?" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.42;entryX=0;entryY=0.42;" edge="1" source="api" target="mysql" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m13" value="Argon2id verify. Unknown username still runs one verify&#10;so timing does not reveal whether the account exists." style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.46;entryX=1;entryY=0.46;strokeColor=#996185;fontColor=#996185;" edge="1" source="api" target="api" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="alt1" value="alt [wrong credentials] : 401 INVALID_CREDENTIALS — identical for wrong username and wrong password" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.50;entryX=1;entryY=0.50;" edge="1" source="api" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="alt2" value="alt [is_active = 0] : 403 ACCOUNT_DISABLED" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.53;entryX=1;entryY=0.53;" edge="1" source="api" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="alt3" value="alt [no network] : &quot;Không kết nối được máy chủ...&quot; — nothing written locally" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.56;entryX=1;entryY=0.56;" edge="1" source="cmd" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="m14" value="else : INSERT INTO sessions (token_hash = sha256(token), client = &apos;app&apos;, expires_at = +30d)" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.60;entryX=0;entryY=0.60;" edge="1" source="api" target="mysql" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m15" value="200 { token, expires_at, user }" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;dashed=1;exitX=0;exitY=0.63;entryX=1;entryY=0.63;" edge="1" source="api" target="cmd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m16" value="DELETE then INSERT auth_session (id = 1) — stores the raw token" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.66;entryX=0;entryY=0.66;" edge="1" source="cmd" target="local" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m17" value="AuthSession WITHOUT the token — the frontend never holds it" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;dashed=1;exitX=0;exitY=0.70;entryX=1;entryY=0.70;" edge="1" source="cmd" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="frame_pw" value="opt [must_change_password = 1]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;width=230;height=26;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="840" width="1470" height="270" as="geometry" />
        </mxCell>
        <mxCell id="m18" value="render the change-password view instead of the procedure list" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;dashed=1;" edge="1" source="cmd" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m19" value="Enter current + new password" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.78;entryX=0;entryY=0.78;" edge="1" source="user" target="ui" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m20" value="invoke(&apos;change_own_password&apos;)" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.81;entryX=0;entryY=0.81;" edge="1" source="ui" target="cmd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m21" value="POST /api/v1/auth/password" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.84;entryX=0;entryY=0.84;" edge="1" source="cmd" target="api" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m22" value="UPDATE password_hash, must_change_password = 0;&#10;revoke every OTHER session of this user" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.88;entryX=0;entryY=0.88;" edge="1" source="api" target="mysql" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m23" value="204 → rewrite auth_session with must_change_password = 0" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;exitX=1;exitY=0.92;entryX=0;entryY=0.92;" edge="1" source="cmd" target="local" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note_401" value="A wrong CURRENT password also returns 401, but that is not an&#10;expired session. The app must not clear auth_session there, or a&#10;single typo would throw the user back to the login screen." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1200" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note_server" value="The server address is never typed at sign-in (§4.4):&#10;env SOP_SERVER_URL, then server.env in the app data folder,&#10;then http://localhost:8080. The login screen only displays it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e6d0de;strokeColor=#996185;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="520" y="1200" width="450" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note_send" value="rusqlite::Connection is not Send, so it cannot be held across&#10;an .await. Every async command closes the DB scope before the&#10;HTTP call and reopens it after — see logout in lib.rs." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1200" width="480" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
