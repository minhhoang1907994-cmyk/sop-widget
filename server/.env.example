# Sao chép thành .env trước khi chạy. KHÔNG commit file .env.
# Mọi tiến trình chạy ở UTC — xem §4.2 của docs/spec/login-report-sharing.md.
TZ=UTC

# HTTP
PORT=8080
HOST=0.0.0.0
# Dùng để dựng share_url trả về cho app. Đổi thành domain thật khi deploy.
PUBLIC_BASE_URL=http://localhost:8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sop
DB_PASSWORD=change-me
DB_NAME=sop_widget

# Nơi lưu file báo cáo HTML. Đường dẫn trong DB là tương đối so với thư mục này.
STORAGE_DIR=./storage/reports

# Phiên đăng nhập — 30 ngày theo D6/BR-19
SESSION_TTL_DAYS=30

# Giới hạn tải lên, MB (Q5 — giá trị tạm)
MAX_UPLOAD_MB=25

# Giới hạn đăng nhập sai (Q4 — giá trị tạm): 10 lần / 15 phút, dùng chung cho cả
# POST /api/v1/auth/login và POST /login
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15

# Tài khoản admin được seed lần đầu (npm run seed:admin)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Quản trị viên
SEED_ADMIN_PASSWORD=change-me-now
