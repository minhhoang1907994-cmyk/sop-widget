{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOP Widget",
  "version": "0.1.0",
  "identifier": "asia.nitro.sop-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "SOP Widget",
      "width": 344,
      "height": 372,
      "minWidth": 320,
      "minHeight": 280,
      "resizable": true,
      "alwaysOnTop": true,
      "decorations": false,
      "transparent": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}
